{
  "name": "bundlestate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Universal, zero-config, client-side diagnostic dashboard for JS/TS application bundles. Drag a build zip with source maps, see exactly which packages (incl. transitive deps) ship — nothing leaves the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimasbaguspm/bundlestate.git"
  },
  "bugs": {
    "url": "https://github.com/dimasbaguspm/bundlestate/issues"
  },
  "homepage": "https://bundlestate.dimasbaguspm.dev",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "fmt": "oxfmt src vite.config.ts vitest.config.ts",
    "fmt:check": "oxfmt --check src vite.config.ts vitest.config.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dexie": "^4.4.5",
    "echarts": "^5.6.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "semantic-release": "^25.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
